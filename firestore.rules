rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidSubscriber() {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'whatsapp', 'createdAt', 'isActive', 'source'])
        && d.email is string
        && d.whatsapp is string
        && d.source is string
        && d.isActive == true
        && d.createdAt is timestamp
        && d.email.size() < 320
        && d.whatsapp.size() < 20
        && (d.email.size() > 4 || d.whatsapp.size() > 7);
    }

    match /events/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /musicTracks/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /galleryImages/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /shopProducts/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /subscribers/{id} {
      allow create: if isValidSubscriber();
      allow update: if isValidSubscriber()
        && request.resource.data.email == resource.data.email;
      allow read, delete: if isSignedIn();
    }
  }
}
